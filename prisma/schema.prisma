generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  nickname   String
  firstname  String
  lastname   String
  email      String   @unique
  username   String   @unique
  password   String
  createdAt  DateTime @default(now())
}